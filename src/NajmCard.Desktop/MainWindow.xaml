<Window x:Class="NajmCard.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="نجم كارد | إدارة الشبكات وطباعة الكروت" Width="1200" Height="780" MinWidth="980" MinHeight="600"
    WindowStartupLocation="CenterScreen" Background="{StaticResource CanvasBrush}" FlowDirection="RightToLeft">
    <Grid>
        <Grid x:Name="LoginLayer" Background="{StaticResource CanvasBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="194"/>
                <ColumnDefinition Width="1.48*"/>
                <ColumnDefinition Width="0.98*"/>
            </Grid.ColumnDefinitions>
            <!-- Right navigation: faithfully grouped like Hadramout, but distinct Najm identity. -->
            <Border Grid.Column="0" Background="#1D122B" BorderBrush="#90643F" BorderThickness="0,0,1,0">
                <DockPanel Margin="13,20">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="✦" Foreground="#FFE0A1" FontSize="38" HorizontalAlignment="Center"/>
                        <TextBlock Text="نجم كارد" FontSize="25" FontWeight="Bold" Foreground="#FFE0A1" HorizontalAlignment="Center"/>
                        <TextBlock Text="NETWORK STUDIO" Foreground="#91A9C7" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,24"/>
                        <Border Height="2" Background="#C8A06D" Margin="0,0,0,15"/>
                        <Border Background="#6E2849" CornerRadius="10" Padding="12,13" Margin="0,0,0,8">
                            <TextBlock Text="◉  تسجيل الدخول" FontSize="14" FontWeight="SemiBold" Foreground="#FFE2A9"/>
                        </Border>
                        <Border Background="#31233C" CornerRadius="10" Padding="12,13" Margin="0,0,0,8">
                            <TextBlock Text="✧  الترخيص والتجربة المجانية" FontSize="12" Foreground="#BFBDD0" TextWrapping="Wrap"/>
                        </Border>
                        <Button Content="حول نجم كارد" Style="{StaticResource OutlineButton}" Margin="0,3,0,10" Click="About_Click"/>
                        <TextBlock Text="خدمة العملاء: لم تُربط بعد" Foreground="#A7C2D4" TextWrapping="Wrap" Margin="5,8"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="نجم كارد 0.1.0&#10;C# / .NET 10" Foreground="#D8B57D" HorizontalAlignment="Center" TextAlignment="Center" FontSize="12"/>
                </DockPanel>
            </Border>
            <!-- RouterOS login, independent 20-day local trial and signed shared paid licensing. -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="630" Margin="25,27,21,22" HorizontalAlignment="Stretch">
                    <Border Background="#302033" BorderBrush="#B48C56" BorderThickness="1" CornerRadius="14" Padding="15,13" Margin="0,0,0,14">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="✦" Foreground="#FFDDA1" FontSize="22" Margin="0,0,12,0"/>
                            <TextBlock Text="تسجيل الدخول إلى MikroTik" Foreground="#FFF0D7" FontWeight="Bold" FontSize="21"/>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource CardPanel}" Background="#341527" BorderBrush="#A38356">
                        <StackPanel>
                            <TextBlock Text="نوع الاتصال" Foreground="{StaticResource GoldBrightBrush}" FontWeight="SemiBold" FontSize="16"/>
                            <StackPanel Orientation="Horizontal" Margin="0,11,0,10">
                                <RadioButton x:Name="LocalModeInput" GroupName="RouterMode" IsChecked="True" Content="محلي" Checked="ConnectionMode_Checked" Margin="0,0,17,0"/>
                                <RadioButton x:Name="RemoteModeInput" GroupName="RouterMode" Content="VPN عن بعد" Checked="ConnectionMode_Checked"/>
                            </StackPanel>
                            <TextBlock x:Name="ConnectionModeHint" Text="محلي: اتصال مباشر على شبكة الراوتر." Foreground="#A8C4DF" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,13"/>
                            <Label Content="محفوظات الاتصالات"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Left" Content="حذف" Style="{StaticResource OutlineButton}" Margin="7,0,0,0" Click="DeleteSavedConnection_Click" MinWidth="65"/>
                                <Button DockPanel.Dock="Left" Content="جديد" Style="{StaticResource OutlineButton}" Margin="7,0,0,0" Click="NewConnection_Click" MinWidth="65"/>
                                <ComboBox x:Name="SavedConnectionsInput" DisplayMemberPath="DisplayName" SelectionChanged="SavedConnections_SelectionChanged" MinWidth="160"/>
                            </DockPanel>
                            <Grid Margin="0,9,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="122"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,9,0">
                                    <Label Content="عنوان الراوتر / IP"/>
                                    <TextBox x:Name="HostInput" Text="192.168.88.1" FlowDirection="LeftToRight"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <Label Content="منفذ API"/>
                                    <TextBox x:Name="PortInput" Text="8728" FlowDirection="LeftToRight"/>
                                </StackPanel>
                            </Grid>
                            <Label Content="اسم المستخدم"/>
                            <TextBox x:Name="UserInput" Text="admin" FlowDirection="LeftToRight"/>
                            <Label Content="كلمة المرور"/>
                            <Grid>
                                <PasswordBox x:Name="PasswordInput" FlowDirection="LeftToRight"/>
                                <TextBox x:Name="VisiblePasswordInput" FlowDirection="LeftToRight" Visibility="Collapsed"/>
                            </Grid>
                            <WrapPanel Margin="0,10,0,4">
                                <CheckBox x:Name="ShowPasswordInput" Content="إظهار كلمة المرور" Checked="RevealPassword_Changed" Unchecked="RevealPassword_Changed" Margin="0,0,10,0"/>
                                <CheckBox x:Name="TlsInput" Content="API-SSL مع التحقق من الشهادة" Margin="0,0,10,0"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,0,0,13">
                                <CheckBox x:Name="SaveConnectionInput" Content="حفظ بيانات الاتصال" Checked="SaveConnection_Changed" Unchecked="SaveConnection_Changed" Margin="0,0,10,0"/>
                                <CheckBox x:Name="SavePasswordInput" Content="حفظ كلمة المرور محمية لـ Windows" IsEnabled="False" Margin="0,0,10,0"/>
                            </WrapPanel>
                            <Border Background="#35233B" CornerRadius="12"
                                    BorderBrush="#C49A66" BorderThickness="1"
                                    Padding="13,11" Margin="0,6,0,12">
                              <StackPanel>
                                <TextBlock Text="الترخيص والتجربة المجانية" FontSize="17"
                                           FontFamily="Arial" FontWeight="Bold" Foreground="#FFE0A0"
                                           Margin="0,0,0,8"/>
                                <TextBlock x:Name="LicenseNotice" FontFamily="Arial"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="#E8D7BE" TextWrapping="Wrap"
                                           Text="اختر التجربة المجانية أو أدخل رمز الترخيص للمتابعة."
                                           Margin="0,0,0,10"/>
                                <Button x:Name="TrialButton" Content="✦ بدء التجربة المجانية — 20 يوما"
                                        Style="{StaticResource PrimaryButton}"
                                        MinHeight="38" Margin="0,0,0,9"
                                        Click="ChooseTrial_Click"/>
                                <TextBlock Text="تبدأ التجربة بعد أول اتصال ناجح بـ MikroTik. البصمة محلية فقط ولا تُرسل لأي منصة."
                                           Foreground="#B7E5D1" FontFamily="Arial" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,0,0,9"/>
                                <DockPanel x:Name="PaidLicenseEntry" LastChildFill="True">
                                  <Button x:Name="ActivateLicenseButton" DockPanel.Dock="Left"
                                          Content="تحقق وتفعيل" Style="{StaticResource OutlineButton}"
                                          MinHeight="39" Margin="6,0,0,0"
                                          Click="ActivateLicense_Click"/>
                                  <TextBox x:Name="LicenseCodeInput" MinHeight="39"
                                           FontFamily="Arial" FontSize="13"
                                           TextAlignment="Center" MaxLength="47"
                                           FlowDirection="LeftToRight" VerticalContentAlignment="Center"
                                           ToolTip="رمز من 32 خانة أصدرته منصة تراخيص حضرموت"/>
                                </DockPanel>
                                <Button x:Name="RenewLicenseButton" Content="تجديد الترخيص أو تغيير الرمز"
                                        Style="{StaticResource OutlineButton}" Visibility="Collapsed"
                                        MinHeight="37" Margin="0,8,0,0"
                                        Click="RenewLicense_Click"/>
                                <TextBlock Text="التفعيل المدفوع يستخدم نفس منصة حضرموت، ويربط الرمز بالجهاز لأول مرة عبر HTTPS."
                                           Foreground="#DCC6DC" FontFamily="Arial" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,9,0,0"/>
                              </StackPanel>
                            </Border>
                            <Button x:Name="ConnectButton" Content="✦  اتصال بالراوتر" Height="52" Style="{StaticResource PrimaryButton}" Click="Connect_Click"/>
                            <TextBlock x:Name="LoginStatus" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,13,0,0" Text="سجل الدخول بالبيانات الخاصة بالراوتر."/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="الاتصال البعيد يتطلب VPN مفعلا مسبقا على Windows. المنفذ 8728 غير مشفر؛ API-SSL يتطلب شهادة موثوقة. حفظ كلمة المرور اختياري ومقيد بحساب Windows الحالي."
                        Foreground="#CBB8AC" TextWrapping="Wrap" FontSize="12" Margin="4,0,0,0"/>
                </StackPanel>
            </ScrollViewer>
            <!-- Premium burgundy/gold geometric brand panel, distinct from the Hadramout layout. -->
            <Border Grid.Column="2" Background="{StaticResource BurgundyGradient}" BorderBrush="#8E633B" BorderThickness="1,0,0,0">
                <Grid Margin="22">
                    <Ellipse Stroke="#45E1BC80" StrokeThickness="2" Width="300" Height="300"/>
                    <Ellipse Stroke="#50F7E1A3" StrokeThickness="1" Width="230" Height="230"/>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="✦" FontSize="78" Foreground="#F8D49B" HorizontalAlignment="Center"/>
                        <TextBlock Text="نـجـم كـارد" FontSize="32" FontWeight="Bold" Foreground="#FFF0D7" HorizontalAlignment="Center"/>
                        <TextBlock Text="إدارة الشبكات وطباعة الكروت" TextWrapping="Wrap" TextAlignment="Center" FontSize="16" Foreground="#F5D7A8" Margin="0,12,0,7"/>
                        <Border Width="180" Height="2" Background="#C99B60" Margin="0,11"/>
                        <TextBlock Text="Hotspot  ·  User Manager v6  ·  PPPoE" FontSize="12" Foreground="#BCDEED" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                        <TextBlock Text="نظام مستقل · تصميم عنابي مذهّب" Foreground="#C6A8AD" FontSize="12" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="WorkspaceLayer" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition Width="247"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="21,31,21,22">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="✦" FontSize="31" Foreground="{StaticResource GoldBrush}" Margin="0,0,12,0"/>
                            <StackPanel><TextBlock Text="نجم كارد" FontSize="25" FontWeight="Bold" Foreground="{StaticResource GoldBrightBrush}"/><TextBlock Text="NETWORK STUDIO" FontSize="10" Foreground="{StaticResource MutedBrush}" FlowDirection="LeftToRight"/></StackPanel>
                        </StackPanel>
                        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,24,0,0"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="17">
                        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,5,0,14"/>
                        <Border Background="#4B1730" BorderBrush="#BA6679" BorderThickness="1"
                                CornerRadius="9" Padding="10,9" Margin="2,0,2,9">
                            <TextBlock x:Name="SidebarLicense" Text="حالة الترخيص"
                                       Foreground="#FFF5E5" FontFamily="Arial" FontWeight="ExtraBold"
                                       FontSize="13" TextAlignment="Center" TextWrapping="Wrap"/>
                        </Border>
                        <Button Content="تسجيل الخروج" Background="#790D20" Foreground="White"
                                Height="46" Style="{StaticResource OutlineButton}" Click="Logout_Click"/>
                    </StackPanel>
                    <ListBox x:Name="NavList" SelectionChanged="NavList_SelectionChanged" Background="Transparent" BorderThickness="0" Padding="7" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Margin" Value="0,2"/><Setter Property="Padding" Value="14,6"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Selection" CornerRadius="9" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Selection" Property="Background" Value="#77432F"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Selection" Property="Background" Value="#4F2933"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Border Width="32" Height="32" CornerRadius="10" Background="{Binding IconBackground}" Margin="0,0,10,0"><Path Data="{Binding Glyph}" Stroke="{Binding Accent}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition x:Name="WorkspaceHeaderRow" Height="88"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#27101C" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="28,15">
                    <DockPanel VerticalAlignment="Center">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border BorderBrush="#80734C" BorderThickness="1" CornerRadius="9" Padding="12,5" Margin="5,0"><TextBlock Text="RouterOS v6" Foreground="{StaticResource GoldBrush}" FontSize="12"/></Border>
                            <Border BorderBrush="#427858" BorderThickness="1" CornerRadius="9" Padding="12,5"><TextBlock Text="● متصل" Foreground="#92DBAE" FontSize="12"/></Border>
                        </StackPanel>
                        <StackPanel><TextBlock x:Name="PageTitle" Text="الرئيسية" FontWeight="Bold" FontSize="22" Foreground="{StaticResource GoldBrightBrush}"/><TextBlock x:Name="PageSubtitle" Text="نظرة عامة على شبكتك" Foreground="{StaticResource MutedBrush}" FontSize="12"/></StackPanel>
                    </DockPanel>
                </Border>
                <ContentControl x:Name="PageHost" Grid.Row="1" Margin="26,24,26,12"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
