<UserControl x:Class="NajmCard.Desktop.Views.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FlowDirection="RightToLeft" MinWidth="0" MinHeight="0">
  <UserControl.Resources>
    <Style x:Key="DashboardPanel" TargetType="Border" BasedOn="{StaticResource CardPanel}">
      <Setter Property="Padding" Value="11"/><Setter Property="CornerRadius" Value="13"/>
    </Style>
    <Style x:Key="StatNumber" TargetType="TextBlock">
      <Setter Property="FontSize" Value="28"/><Setter Property="FontWeight" Value="ExtraBold"/>
      <Setter Property="Foreground" Value="#FFE2A5"/><Setter Property="Margin" Value="0,4,0,0"/>
    </Style>
    <Style x:Key="Tiny" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#E6CDD2"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="HeaderLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#FFE3B3"/>
    </Style>
    <Style x:Key="QuickButton" TargetType="Button" BasedOn="{StaticResource OutlineButton}">
      <Setter Property="Padding" Value="5,6"/><Setter Property="Margin" Value="2"/>
      <Setter Property="MinHeight" Value="38"/><Setter Property="MinWidth" Value="0"/>
    </Style>
  </UserControl.Resources>

  <!-- No ScrollViewer: four compact responsive dashboard rows fit the enlarged window. -->
  <Grid x:Name="DashboardLayout" ClipToBounds="True">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="115"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="179"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Margin="0,0,0,7" CornerRadius="9" Padding="8,5"
            Background="#640E2B" BorderBrush="#D7AE66" BorderThickness="1">
      <DockPanel LastChildFill="True" MinHeight="42">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="LifecycleButton" Content="◉ تحديث حالة الكروت"
                  Style="{StaticResource OutlineButton}" Background="#164D85"
                  Foreground="White" Padding="12,6" Margin="3,0"
                  Click="Lifecycle_Click"/>
          <Button Content="⟳ تحديث مباشر" Style="{StaticResource OutlineButton}"
                  Background="#137E70" Foreground="White"
                  Padding="12,6" Margin="3,0" Click="Refresh_Click"/>
          <Border Background="#18513C" BorderBrush="#5AD2A1" BorderThickness="1"
                  CornerRadius="7" Padding="11,6" Margin="7,0">
            <TextBlock Text="●  متصل" Foreground="#AFFFE0" FontSize="12"
                       FontWeight="ExtraBold"/>
          </Border>
        </StackPanel>
        <TextBlock Text="الرئيسية" FontSize="21" FontWeight="ExtraBold"
                   Foreground="#FFE4AC" VerticalAlignment="Center" Margin="6,0"/>
      </DockPanel>
    </Border>
    <!-- Row 1: total, live connections and compact CPU/RAM, not duplicated lifecycle cards. -->
    <Grid Grid.Row="1" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource DashboardPanel}"
              Background="#492137" BorderBrush="#B48764" Margin="0,0,6,0">
        <DockPanel>
          <Border DockPanel.Dock="Left" Background="#653D6D" Width="42" Height="42" CornerRadius="11">
            <Path Data="{StaticResource IconCard}" Stroke="#E7C0FF" StrokeThickness="1.8"
                  Width="23" Height="23" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
          </Border>
          <StackPanel>
            <TextBlock Text="إجمالي الكروت" Style="{StaticResource HeaderLabel}"/>
            <TextBlock x:Name="AllUsers" Text="—" Style="{StaticResource StatNumber}"/>
            <TextBlock Text="User Manager v6" Style="{StaticResource Tiny}"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource DashboardPanel}"
              Background="#244238" BorderBrush="#62A18B" Margin="0,0,6,0">
        <DockPanel>
          <Border DockPanel.Dock="Left" Background="#2A6759" Width="42" Height="42" CornerRadius="11">
            <Path Data="{StaticResource IconPeople}" Stroke="#91F1D6" StrokeThickness="2"
                  Width="23" Height="23" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
          </Border>
          <StackPanel>
            <TextBlock Text="المتصلون الآن" Style="{StaticResource HeaderLabel}"/>
            <TextBlock x:Name="Online" Text="—" Style="{StaticResource StatNumber}" Foreground="#A9F5D8"/>
            <TextBlock x:Name="OnlineBreakdown" Text="Hotspot + PPPoE" Style="{StaticResource Tiny}"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource DashboardPanel}"
              Background="#322538" BorderBrush="#9E7A66">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,12,0">
            <DockPanel>
              <TextBlock Text="أداء الراوتر" Style="{StaticResource HeaderLabel}"/>
              <Path DockPanel.Dock="Left" Data="{StaticResource IconCpu}" Stroke="#DAB982"
                    StrokeThickness="2" Width="16" Height="16"/>
            </DockPanel>
            <DockPanel Margin="0,6,0,1">
              <TextBlock Text="المعالج" Style="{StaticResource Tiny}"/>
              <TextBlock x:Name="Cpu" Text="—" FontSize="13" FontWeight="Bold"
                         Foreground="#FFD68B" DockPanel.Dock="Left"/>
            </DockPanel>
            <ProgressBar x:Name="CpuProgress" Height="7" Minimum="0" Maximum="100"
                         Foreground="#E0B56D" Background="#4A3645" BorderThickness="0"/>
          </StackPanel>
          <StackPanel Grid.Column="1">
            <DockPanel Margin="0,1,0,1">
              <TextBlock Text="الذاكرة" Style="{StaticResource Tiny}"/>
              <TextBlock x:Name="MemoryUsePercent" Text="—" FontSize="13"
                         FontWeight="Bold" Foreground="#8EDCF2" DockPanel.Dock="Left"/>
            </DockPanel>
            <ProgressBar x:Name="MemoryProgress" Height="7" Minimum="0" Maximum="100"
                         Foreground="#78C3E9" Background="#4A3645" BorderThickness="0" Margin="0,4,0,4"/>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="الحرة: " Style="{StaticResource Tiny}"/>
              <TextBlock x:Name="MemoryFree" Text="—" Style="{StaticResource Tiny}" FontWeight="Bold"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="التشغيل: " Style="{StaticResource Tiny}"/>
              <TextBlock x:Name="Uptime" Text="—" Style="{StaticResource Tiny}" FontWeight="Bold"/>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- Row 2: lifecycle + top packages + real local activity. -->
    <Grid Grid.Row="2" Margin="0,0,0,8" MinHeight="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.38*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource DashboardPanel}"
              BorderBrush="#D8A56D" Background="#3E1C34" Margin="0,0,6,0">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel Grid.Row="0" Margin="0,0,0,5">
            <TextBlock Text="حالة الكروت" Style="{StaticResource HeaderLabel}"/>
            <TextBlock DockPanel.Dock="Left" Text="User Manager v6" Style="{StaticResource Tiny}"/>
          </DockPanel>
          <!-- Hadramout-inspired geometric 3-column lifecycle table; no radial chart. -->
           <Grid Grid.Row="1" VerticalAlignment="Center">
             <Grid.ColumnDefinitions>
               <ColumnDefinition Width="1.3*"/>
               <ColumnDefinition Width="0.8*"/>
               <ColumnDefinition Width="0.85*"/>
             </Grid.ColumnDefinitions>
             <Grid.RowDefinitions>
               <RowDefinition Height="34"/>
               <RowDefinition Height="42"/>
               <RowDefinition Height="42"/>
               <RowDefinition Height="42"/>
             </Grid.RowDefinitions>
             <Border Grid.Row="0" Grid.ColumnSpan="3" CornerRadius="6,6,0,0" Background="#5E2440"/>
             <TextBlock Grid.Row="0" Grid.Column="0" Text="نوع الكرت" Foreground="White"
                        FontSize="12" FontWeight="ExtraBold" VerticalAlignment="Center"
                        HorizontalAlignment="Center"/>
             <TextBlock Grid.Row="0" Grid.Column="1" Text="العدد" Foreground="White"
                        FontSize="12" FontWeight="ExtraBold" VerticalAlignment="Center"
                        HorizontalAlignment="Center"/>
             <TextBlock Grid.Row="0" Grid.Column="2" Text="النسبة %" Foreground="White"
                        FontSize="12" FontWeight="ExtraBold" VerticalAlignment="Center"
                        HorizontalAlignment="Center"/>
             <Border Grid.Row="1" Grid.ColumnSpan="3" Background="#284639"/>
             <Border Grid.Row="2" Grid.ColumnSpan="3" Background="#4C2939"/>
             <Border Grid.Row="3" Grid.ColumnSpan="3" Background="#403529"/>
             <TextBlock Grid.Row="1" Grid.Column="0" Text="نشطة" Foreground="#A3F7D2"
                        FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="10,0"/>
             <TextBlock Grid.Row="2" Grid.Column="0" Text="منتهية" Foreground="#FFB7C4"
                        FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="10,0"
                        ToolTip="استنفاد Transfer Limit الموجب فقط"/>
             <TextBlock Grid.Row="3" Grid.Column="0" Text="صالحة" Foreground="#FFE5A6"
                        FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="10,0"/>
             <TextBlock x:Name="ActiveLegend" Grid.Row="1" Grid.Column="1" Text="—"
                        Foreground="White" FontWeight="ExtraBold" FontSize="15"
                        VerticalAlignment="Center" TextAlignment="Center"/>
             <TextBlock x:Name="ExpiredLegend" Grid.Row="2" Grid.Column="1" Text="—"
                        Foreground="White" FontWeight="ExtraBold" FontSize="15"
                        VerticalAlignment="Center" TextAlignment="Center"/>
             <TextBlock x:Name="DisabledLegend" Grid.Row="3" Grid.Column="1" Text="—"
                        Foreground="White" FontWeight="ExtraBold" FontSize="15"
                        VerticalAlignment="Center" TextAlignment="Center"/>
             <TextBlock x:Name="ActivePercent" Grid.Row="1" Grid.Column="2" Text="—"
                        Foreground="#A3F7D2" FontWeight="ExtraBold" FontSize="14"
                        VerticalAlignment="Center" TextAlignment="Center"/>
             <TextBlock x:Name="ExpiredPercent" Grid.Row="2" Grid.Column="2" Text="—"
                        Foreground="#FFB7C4" FontWeight="ExtraBold" FontSize="14"
                        VerticalAlignment="Center" TextAlignment="Center"/>
             <TextBlock x:Name="ValidPercent" Grid.Row="3" Grid.Column="2" Text="—"
                        Foreground="#FFE5A6" FontWeight="ExtraBold" FontSize="14"
                        VerticalAlignment="Center" TextAlignment="Center"/>
             <TextBlock x:Name="Enabled" Visibility="Collapsed" Text="—"/>
             <TextBlock x:Name="Expired" Visibility="Collapsed" Text="—"/>
           </Grid>
           <WrapPanel Grid.Row="2" HorizontalAlignment="Center">
            <Button Content="عرض النشطة" Tag="active" Click="OpenLifecycleDetails_Click"
                    Style="{StaticResource OutlineButton}" Padding="9,5" Margin="2"/>
            <Button Content="عرض المنتهية" Tag="expired" Click="OpenLifecycleDetails_Click"
                    Style="{StaticResource OutlineButton}" Padding="9,5" Margin="2"/>
          </WrapPanel>
        </Grid>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource DashboardPanel}" Background="#32233D"
              BorderBrush="#9677C7" Margin="0,0,6,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="أكثر الباقات استخداماً"
                     Style="{StaticResource HeaderLabel}" Margin="0,0,0,9"/>
          <StackPanel x:Name="ProfileBars"/>
        </DockPanel>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource DashboardPanel}" Background="#27353E"
              BorderBrush="#6590AD">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="آخر النشاط — سجل العمليات"
                     Style="{StaticResource HeaderLabel}" Margin="0,0,0,8"/>
          <StackPanel x:Name="ActivityRows"/>
        </DockPanel>
      </Border>
    </Grid>

    <!-- Row 3: the router, quick actions and refresh history share a single tier. -->
    <Grid Grid.Row="3" Margin="0,0,0,6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.55*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource DashboardPanel}" Margin="0,0,6,0"
              BorderBrush="#A78B66">
        <StackPanel>
          <TextBlock Text="بيانات الراوتر" Style="{StaticResource HeaderLabel}" Margin="0,0,0,7"/>
          <TextBlock x:Name="RouterName" Text="—" FontSize="16" FontWeight="Bold"
                     Foreground="#FFE0A0" TextTrimming="CharacterEllipsis"/>
          <DockPanel Margin="0,5,0,0">
            <TextBlock Text="اللوحة" Style="{StaticResource Tiny}"/>
            <TextBlock x:Name="RouterBoard" Text="—" DockPanel.Dock="Left" Style="{StaticResource Tiny}"/>
          </DockPanel>
          <DockPanel Margin="0,4,0,0">
            <TextBlock Text="الإصدار" Style="{StaticResource Tiny}"/>
            <TextBlock x:Name="RouterVersion" Text="—" DockPanel.Dock="Left" Style="{StaticResource Tiny}"/>
          </DockPanel>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource DashboardPanel}" Margin="0,0,6,0"
              BorderBrush="#5C9A89" Background="#293A36">
        <StackPanel>
          <TextBlock Text="إجراءات سريعة" Style="{StaticResource HeaderLabel}" Margin="0,0,0,8"/>
          <UniformGrid Columns="3">
            <Button Click="NewCards_Click" Style="{StaticResource QuickButton}" ToolTip="إنشاء وطباعة الكروت">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Path Data="{StaticResource IconPlus}" Stroke="#FFE0A2" StrokeThickness="2"
                      Width="14" Height="14" Margin="0,0,5,0"/>
                <TextBlock Text="إنشاء" Foreground="#FFF2D9" FontSize="11" FontWeight="Bold"/>
              </StackPanel>
            </Button>
            <Button Click="ManageCards_Click" Style="{StaticResource QuickButton}" ToolTip="إدارة الكروت">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Path Data="{StaticResource IconCard}" Stroke="#B8F2E0" StrokeThickness="2"
                      Width="14" Height="14" Margin="0,0,5,0"/>
                <TextBlock Text="الكروت" Foreground="#FFF2D9" FontSize="11" FontWeight="Bold"/>
              </StackPanel>
            </Button>
            <Button Click="Reports_Click" Style="{StaticResource QuickButton}" ToolTip="تقارير الشبكة">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Path Data="{StaticResource IconReport}" Stroke="#BEDDFF" StrokeThickness="2"
                      Width="14" Height="14" Margin="0,0,5,0"/>
                <TextBlock Text="التقارير" Foreground="#FFF2D9" FontSize="11" FontWeight="Bold"/>
              </StackPanel>
            </Button>
          </UniformGrid>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource DashboardPanel}"
               BorderBrush="#DCAA66" Background="#35263B">
         <StackPanel>
           <TextBlock Text="التحكم بالشبكة والصيانة" Style="{StaticResource HeaderLabel}" Margin="0,0,0,8"/>
           <UniformGrid Columns="2" Margin="0,0,0,8">
             <Button Content="⏻ تعطيل الهوتسبوت" Click="Maintenance_Click"
                     Style="{StaticResource QuickButton}" Background="#A42A4E"
                     Foreground="White" ToolTip="افتح أدوات الصيانة، ثم اختر السيرفر وأكد التعطيل"/>
             <Button Content="⚙ إعادة بناء / تحسين" Click="Maintenance_Click"
                     Style="{StaticResource QuickButton}" Background="#1373A1"
                     Foreground="White" ToolTip="افتح أدوات تحسين وصيانة الراوتر مع التأكيد"/>
           </UniformGrid>
           <TextBlock Text="سجل تحديث لوحة التحكم" Style="{StaticResource HeaderLabel}"
                      FontSize="13" Margin="0,2,0,5"/>
           <TextBlock x:Name="RefreshHistory" Text="لم يجر تحديث بعد"
                      Style="{StaticResource Tiny}" TextWrapping="Wrap"/>
           <TextBlock x:Name="RouterEndpointInfo" Text="" Style="{StaticResource Tiny}"
                      Margin="0,3,0,0" TextWrapping="Wrap"/>
           <TextBlock x:Name="LifecycleStatus" Text="لم تُقرأ حالة الكروت بعد."
                      Style="{StaticResource Tiny}" TextWrapping="Wrap" Margin="0,4,0,0"/>
         </StackPanel>
       </Border>
    </Grid>
    <TextBlock x:Name="ErrorStatus" Grid.Row="4" Text=""
               FontSize="11" Foreground="#F2D1B9" TextTrimming="CharacterEllipsis"
               Margin="3,0,0,0"/>
  </Grid>
</UserControl>
